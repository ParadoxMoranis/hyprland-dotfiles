# Managed by the two-theme switcher.

font=Noto Sans CJK SC 11
background-color=#f4f4f4f0
text-color=#101010
border-color=#111111cc
border-size=1
border-radius=10
padding=12,16
margin=8
width=320
height=120
max-visible=5
sort=-time

anchor=top-right
layer=overlay

icons=1
icon-path=/usr/share/icons/hicolor

default-timeout=3000
ignore-timeout=0

[urgency=low]
background-color=#f4f4f4e8
text-color=#5a5a5a
border-color=#66666699
default-timeout=3000

[urgency=normal]
background-color=#f4f4f4f0
text-color=#101010
border-color=#111111cc
border-size=1
default-timeout=3000

[urgency=high]
background-color=#111111ee
text-color=#f4f4f4
border-color=#111111
border-size=2
default-timeout=0
